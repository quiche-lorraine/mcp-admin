[Unit]
Description=infra-mcp - serveur MCP de pilotage Ansible
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=infra-mcp
Group=infra-mcp
# IP de la passerelle du réseau Docker de Coolify : joignable par Traefik,
# pas depuis Internet. À vérifier avec :
#   docker network inspect coolify -f '{{ (index .IPAM.Config 0).Gateway }}'
Environment=INFRA_MCP_HOST=10.0.1.1
Environment=INFRA_MCP_PORT=8765
Environment=INFRA_MCP_ANSIBLE_DIR=/opt/infra/ansible
Environment=INFRA_MCP_TOKENS=/etc/infra-mcp/tokens.json
Environment=INFRA_MCP_AUDIT_LOG=/var/log/infra-mcp/audit.jsonl
# Mot de passe ansible-vault (0400, propriétaire infra-mcp). Ansible déchiffre
# les secrets au moment d'exécuter ; host_vars masque les variables vault_*.
Environment=ANSIBLE_VAULT_PASSWORD_FILE=/etc/infra-mcp/vault-pass
ExecStart=/opt/infra-mcp/venv/bin/infra-mcp serve
Restart=on-failure

# Durcissement : le service n'écrit que dans ses propres dossiers. Le repo
# Ansible (/opt/infra) reste en lecture seule : seul infra-mcp-sync le met à jour.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/infra-mcp /var/log/infra-mcp

[Install]
WantedBy=multi-user.target
