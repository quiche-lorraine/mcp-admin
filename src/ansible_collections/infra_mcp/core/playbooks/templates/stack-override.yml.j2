{# Fusionné par playbooks/stacks.yml au compose de chaque stack. #}
services:
{% for service in stack.services %}
  {{ service }}:
    deploy:
      labels:
        infra.stack-hash: "{{ stack.hash }}"
{% endfor %}
{% if stack.secrets %}
secrets:
{% for secret in stack.secrets %}
  {{ secret }}:
    external: true
    name: "{{ stacks_secret_versions[secret] }}"
{% endfor %}
{% endif %}
{# Trafic entre nœuds chiffré (IPsec) : réseau par défaut et réseaux déclarés.
   Les réseaux partagés (external) sont créés chiffrés par le playbook.
   docker stack deploy remplace la définition d'un réseau d'un fichier à l'autre
   au lieu de les fusionner : on reprend celle du compose (internal, driver,
   labels…) en y ajoutant le chiffrement. #}
networks:
{% for network in (['default'] + stack.networks) | unique %}
{%   set definition = stack.network_defs.get(network) %}
{%   if definition is not mapping %}{% set definition = {} %}{% endif %}
  {{ network }}: {{ definition | combine({'driver_opts': (definition.driver_opts | default({}, true)) | combine({'encrypted': 'true'})}) | to_json }}
{% endfor %}
