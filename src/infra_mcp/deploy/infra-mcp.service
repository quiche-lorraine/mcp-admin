[Unit]
Description=infra-mcp - serveur MCP de pilotage Ansible
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=infra-mcp
Group=infra-mcp
# Écoute locale par défaut. Les réglages propres à la machine vont dans
# /etc/infra-mcp/infra-mcp.env (créé par infra-mcp-admin), qui l'emporte : par
# exemple INFRA_MCP_HOST=<passerelle du réseau Docker du reverse proxy>, joignable
# par lui mais pas depuis Internet :
#   docker network inspect <réseau du proxy> -f '{{ (index .IPAM.Config 0).Gateway }}'
Environment=INFRA_MCP_HOST=127.0.0.1
Environment=INFRA_MCP_PORT=8765
Environment=INFRA_MCP_ANSIBLE_DIR=/opt/infra
Environment=INFRA_MCP_TOKENS=/etc/infra-mcp/tokens.json
Environment=INFRA_MCP_AUDIT_LOG=/var/log/infra-mcp/audit.jsonl
# Mot de passe ansible-vault (0400, propriétaire infra-mcp). Ansible déchiffre
# les secrets au moment d'exécuter ; host_vars masque les variables vault_*.
Environment=ANSIBLE_VAULT_PASSWORD_FILE=/etc/infra-mcp/vault-pass
EnvironmentFile=-/etc/infra-mcp/infra-mcp.env
ExecStart=/opt/infra-mcp/venv/bin/infra-mcp serve
Restart=on-failure

# Durcissement : le service n'écrit que dans ses propres dossiers. Le repo
# Ansible (/opt/infra) reste en lecture seule : seul infra-mcp-sync le met à jour.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/infra-mcp /var/log/infra-mcp
# Aucun privilège : le service ne fait que du réseau (HTTP, SSH) et lire/écrire
# ses propres fichiers. Vérifier après installation : systemd-analyze security infra-mcp
CapabilityBoundingSet=
AmbientCapabilities=
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
